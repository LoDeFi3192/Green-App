rules_version = '2';

// =====================================================================
// Bloom — Firestore security rules
// =====================================================================
// Chaque utilisateur ne peut lire/écrire QUE son propre document.
// Le document est stocké dans /bloom/{uid} où {uid} doit correspondre
// à l'ID de l'utilisateur authentifié.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // L'utilisateur lit/écrit uniquement son propre jardin
    match /bloom/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         // Empêche un document trop gros
                         && (request.resource == null || request.resource.size < 1000000);
    }

    // Tout le reste est refusé par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
